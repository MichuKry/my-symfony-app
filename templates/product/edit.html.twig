{% extends 'base.html.twig' %}
{% block title %}Edycja Produktu{% endblock %}
{% block body %}
<style>
    body { background: #1a1a1a; color: white; font-family: sans-serif; }
    .container { max-width: 600px; margin: 50px auto; padding: 20px; background: #252525; border-radius: 8px; }
    .form-control { width: 100%; padding: 10px; margin-bottom: 15px; background: #333; border: 1px solid #444; color: white; }
    .btn-save { width: 100%; padding: 12px; background: #007bff; color: white; border: none; cursor: pointer; }
    img { max-width: 150px; display: block; margin: 10px auto; border-radius: 5px; }
</style>

<div class="container">
    <h1 style="text-align: center;">Edytuj Produkt</h1>
    
    {% if product.imageFilename %}
        <div style="text-align: center; margin-bottom: 20px;">
            <p>Obecne zdjęcie:</p>
            {% if product.imageFilename starts with 'http' %}
                <img src="{{ product.imageFilename }}">
            {% else %}
                <img src="{{ asset(product.imageFilename) }}">
            {% endif %}
        </div>
    {% endif %}

    {{ form(form) }}
    
    <div style="text-align: center; margin-top: 20px;">
        <a href="{{ path('app_products_list') }}" style="color: #ccc;">Anuluj</a>
    </div>
</div>
{% endblock %}