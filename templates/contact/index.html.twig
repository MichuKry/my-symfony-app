{% extends 'base.html.twig' %}

{% block title %}Kontakt{% endblock %}

{% block body %}
<style>
    body { background: #1a1a1a; color: white; font-family: sans-serif; }
    .nav-bar { background: #000; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; }
    .nav-links a { color: #ccc; margin-right: 20px; text-decoration: none; font-weight: bold; }
    .nav-links a:hover { color: #ffd700; }
    .container { max-width: 800px; margin: 50px auto; padding: 30px; background: #252525; border-radius: 10px; border: 1px solid #333; }
    .form-control { width: 100%; padding: 12px; margin-bottom: 15px; background: #333; border: 1px solid #444; color: white; border-radius: 5px; box-sizing: border-box; }
    .btn-save { width: 100%; padding: 15px; background: #ffd700; color: black; font-weight: bold; border: none; border-radius: 5px; cursor: pointer; font-size: 1.1em; }
    .alert-success { background: #28a745; color: white; padding: 15px; border-radius: 5px; margin-bottom: 20px; text-align: center; }
</style>

<div class="nav-bar">
    <div class="nav-links">
        <a href="{{ path('app_home') }}">Strona Główna</a>
        <a href="{{ path('app_products_list') }}">Nasze Produkty</a>
        <a href="{{ path('app_contact') }}" style="color: #ffd700;">Kontakt</a>
    </div>
</div>

<div class="container">
    <h1 style="text-align: center; color: #ffd700;">Napisz do nas</h1>

    {% for message in app.flashes('success') %}
        <div class="alert-success">{{ message }}</div>
    {% endfor %}

    {{ form_start(form) }}
        {{ form_widget(form) }}
    {{ form_end(form) }}
</div>
{% endblock %}