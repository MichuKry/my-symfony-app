{% extends 'base.html.twig' %}

{% block title %}Twój Koszyk{% endblock %}

{% block body %}
<style>
    body { background: #1a1a1a; color: white; font-family: sans-serif; }
    .nav-bar { background: #000; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #333; }
    .nav-links a { color: #ccc; margin-right: 20px; text-decoration: none; font-weight: bold; }
    .container { max-width: 1000px; margin: 50px auto; padding: 20px; }
    .cart-table { width: 100%; border-collapse: collapse; background: #252525; border-radius: 8px; overflow: hidden; }
    .cart-table th, .cart-table td { padding: 15px; text-align: left; border-bottom: 1px solid #333; }
    .cart-table th { background: #333; color: #ffd700; }
    .cart-img { width: 50px; height: 50px; object-fit: cover; border-radius: 4px; }
    .btn-remove { color: #ff6b6b; text-decoration: none; font-weight: bold; }
    .summary { text-align: right; margin-top: 20px; font-size: 1.5em; }
    .total-price { color: #ffd700; font-weight: bold; }
    .actions { display: flex; justify-content: space-between; margin-top: 30px; }
    .btn-continue { padding: 10px 20px; background: #444; color: white; text-decoration: none; border-radius: 5px; }
    .btn-checkout { padding: 15px 40px; background: #28a745; color: white; text-decoration: none; border-radius: 5px; font-weight: bold; }
</style>

<div class="nav-bar">
    <div class="nav-links">
        <a href="{{ path('app_home') }}">Strona Główna</a>
        <a href="{{ path('app_products_list') }}">Sklep</a>
        <a href="{{ path('app_cart') }}" style="color: #ffd700;">Koszyk 🛒</a>
    </div>
</div>

<div class="container">
    <h1>Twój Koszyk</h1>

    {% if items|length > 0 %}
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Produkt</th>
                    <th>Cena</th>
                    <th>Ilość</th>
                    <th>Razem</th>
                    <th>Akcja</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                <tr>
                    <td>{{ item.product.name }}</td>
                    <td>{{ item.product.price / 100 }} PLN</td>
                    <td>{{ item.quantity }}</td>
                    <td>{{ (item.product.price * item.quantity) / 100 }} PLN</td>
                    <td><a href="{{ path('app_cart_remove', {id: item.product.id}) }}" class="btn-remove">Usuń 🗑️</a></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <div class="summary">Suma: <span class="total-price">{{ total / 100 }} PLN</span></div>
        <div class="actions">
            <a href="{{ path('app_products_list') }}" class="btn-continue">← Dalej</a>
            <a href="#" class="btn-checkout">Kasa 💳</a>
        </div>
    {% else %}
        <p>Koszyk jest pusty.</p>
    {% endif %}
</div>
{% endblock %}